# Database Credentials
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zwiggy_db
PG_USER=postgres
PG_PASSWORD=postgres

# Warehouse Credentials (optional; defaults to source credentials if omitted)
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=zwiggy_dwh
WAREHOUSE_USER=postgres
WAREHOUSE_PASSWORD=postgres

# Pipeline Settings
DEFAULT_LOOKBACK_DAYS=7
BATCH_SIZE=10000
BUSINESS_TIMEZONE=UTC
CODE_VERSION=1.0.0
STATEMENT_TIMEOUT_MS=60000

# Cohort & Quality Thresholds
ACTIVE_CUSTOMER_WINDOW_DAYS=90
ON_TIME_THRESHOLD_MINUTES=45
UNKNOWN_SK_BLOCK_THRESHOLD=0.05
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
